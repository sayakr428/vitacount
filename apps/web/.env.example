NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

ANTHROPIC_API_KEY=
# Receipt/bill OCR via NVIDIA NIM, used only when ANTHROPIC_API_KEY is empty (server-only)
NVIDIA_API_KEY=
NVIDIA_VLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Vita voice/chat assistant (services/voice-agent). Off = no dock, no extra bundle.
NEXT_PUBLIC_AGENT_ENABLED=false
NEXT_PUBLIC_AGENT_URL=http://localhost:7860
# Same value as AGENT_SHARED_SECRET in services/voice-agent/.env (server-only).
AGENT_SHARED_SECRET=
