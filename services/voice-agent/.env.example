# One NVIDIA key (build.nvidia.com) powers LLM, speech-to-text and text-to-speech.
NVIDIA_API_KEY=
# Main conversational model. Must support streaming tool calls.
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Hidden reasoning before each reply. Off keeps first words at ~0.5s.
NVIDIA_LLM_THINKING=false
# Small/fast model for the on-screen element classifier (Phase 3).
NVIDIA_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Aria

VITACOUNT_WEB_URL=http://localhost:3000
# Must equal AGENT_SHARED_SECRET in apps/web/.env.local. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_SHARED_SECRET=
# Comma-separated browser origins allowed to open a session with the bot.
ALLOWED_ORIGINS=http://localhost:3000
# Optional, production transport (Phase 7).
DAILY_API_KEY=
